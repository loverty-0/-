<Window x:Class="Yakupova_A_Obuv.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Yakupova_A_Obuv"
        Title="Чудо Обувь - Каталог товаров" 
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        FontFamily="Calibri"
        Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ШАПКА -->
        <Border Grid.Row="0" Background="#D2F6E7" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" 
                       Source="pack://application:,,,/Resources/Чудо Обувь.png"
                       Height="50" 
                       Margin="0,0,15,0"/>

                <TextBlock Grid.Column="1" 
                           Text="Каталог товаров" 
                           FontSize="22" 
                           FontWeight="Bold"
                           Foreground="#70B2AF"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2" 
                           x:Name="txtUserName"
                           Text="Гость" 
                           FontSize="14" 
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ЗАГОЛОВОК СПИСКА -->
        <Border Grid.Row="1" Background="#70B2AF" Padding="15,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Изображение" Foreground="White" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="Информация о товаре" Foreground="White" FontWeight="Bold"/>
                <TextBlock Grid.Column="2" Text="Цена" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- СПИСОК ТОВАРОВ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="icProducts">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#D2F6E7" 
                                BorderThickness="1" 
                                Margin="10,5"
                                Padding="10"
                                CornerRadius="5"
                                Background="{Binding RowBackground}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>

                                <!-- Изображение -->
                                <Border Grid.Column="0" 
                                        BorderBrush="#D2F6E7" 
                                        BorderThickness="1"
                                        Width="100" Height="100">
                                    <Image Source="{Binding ImagePath}" Stretch="Uniform"/>
                                </Border>

                                <!-- Информация -->
                                <StackPanel Grid.Column="1" Margin="15,0">
                                    <TextBlock FontSize="16" FontWeight="Bold">
                                        <Run Text="{Binding Manufacturer}"/>
                                        <Run Text=" | "/>
                                        <Run Text="{Binding ProductName}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="13" Foreground="#555" Margin="0,5,0,0">
                                        <Run Text="Категория: "/>
                                        <Run Text="{Binding CategoryName}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="13" Foreground="#555">
                                        <Run Text="Количество: "/>
                                        <Run Text="{Binding QuantityLabel}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="#777" TextWrapping="Wrap"
                                               Margin="0,5,0,0" MaxHeight="40">
                                        <Run Text="{Binding Composition}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Цена -->
                                <StackPanel Grid.Column="2" 
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <TextBlock FontSize="20" 
                                               FontWeight="Bold"
                                               Foreground="#70B2AF"
                                               HorizontalAlignment="Right">
                                        <Run Text="{Binding FinalPrice}"/>
                                        <Run Text=" ₽"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12" 
                                               Foreground="#999"
                                               TextDecorations="Strikethrough"
                                               HorizontalAlignment="Right"
                                               Visibility="{Binding OldPriceVisibility}">
                                        <Run Text="{Binding BasePrice}"/>
                                        <Run Text=" ₽"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>